@page
@model AuditManager.Web.Pages.Auditorias.CreateModel
@{
    ViewData["Title"] = "Nueva Auditoría";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-3 me-3">
                        <i class="bi bi-plus-square fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Nueva Auditoría</h4>
                        <p class="text-muted small mb-0">Complete los detalles para iniciar el proceso</p>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Command.Titulo" class="form-control border-secondary-subtle bg-body-tertiary rounded-3 shadow-none" placeholder="Título" />
                        <label asp-for="Command.Titulo">Título de la Auditoría</label>
                        <span asp-validation-for="Command.Titulo" class="text-danger small"></span>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Command.AreaAuditada" class="form-control border-secondary-subtle bg-body-tertiary rounded-3 shadow-none" placeholder="Área" />
                        <label asp-for="Command.AreaAuditada">Área Auditada</label>
                        <span asp-validation-for="Command.AreaAuditada" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Command.FechaInicio" type="date" class="form-control border-secondary-subtle bg-body-tertiary rounded-3 shadow-none" placeholder="Inicio" />
                                <label asp-for="Command.FechaInicio">Fecha Inicio</label>
                                <span asp-validation-for="Command.FechaInicio" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Command.FechaFin" type="date" class="form-control border-secondary-subtle bg-body-tertiary rounded-3 shadow-none" placeholder="Fin" />
                                <label asp-for="Command.FechaFin">Fecha Fin</label>
                                <span asp-validation-for="Command.FechaFin" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-4">
                        <select asp-for="Command.ResponsableId" asp-items="Model.ResponsablesSelectList" class="form-select border-secondary-subtle bg-body-tertiary rounded-3 shadow-none">
                            <option value="">-- Seleccione un responsable --</option>
                        </select>
                        <label asp-for="Command.ResponsableId">Responsable</label>
                        <span asp-validation-for="Command.ResponsableId" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 flex-grow-1 shadow-sm">
                            <i class="bi bi-check-lg me-2"></i>Guardar Auditoría
                        </button>
                        <a asp-page="/Index" class="btn btn-light border rounded-pill px-4">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
