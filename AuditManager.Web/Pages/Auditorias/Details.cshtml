@page "{id:Guid}"
@model AuditManager.Web.Pages.Auditorias.DetailsModel
@{
    ViewData["Title"] = "Detalles de Auditoría";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2 small">
                <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none">Auditorías</a></li>
                <li class="breadcrumb-item active" aria-current="page">Detalles</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0">@Model.Auditoria.Titulo</h2>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        @{
            var statusBadge = Model.Auditoria.Estado == AuditManager.Core.Enums.EstadoAuditoria.Pendiente ? "bg-warning" : 
                            Model.Auditoria.Estado == AuditManager.Core.Enums.EstadoAuditoria.EnProceso ? "bg-info" : "bg-success";
            var statusIcon = Model.Auditoria.Estado == AuditManager.Core.Enums.EstadoAuditoria.Pendiente ? "bi-clock" : 
                           Model.Auditoria.Estado == AuditManager.Core.Enums.EstadoAuditoria.EnProceso ? "bi-play-circle" : "bi-check-circle";
        }
        <span class="badge rounded-pill @statusBadge bg-opacity-10 text-@statusBadge.Replace("bg-", "") border border-@statusBadge.Replace("bg-", "") fs-6 px-3 py-2 shadow-sm">
            <i class="bi @statusIcon me-2"></i>@Model.Auditoria.Estado
        </span>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-flex align-items-center mb-4 shadow-sm" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i>
        <div>@TempData["Error"]</div>
    </div>
}

<div class="row g-4 mb-5">
    <!-- Información General -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0">Información de la Auditoría</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="small text-muted d-block mb-1">Área Auditada</label>
                        <div class="p-3 bg-body-tertiary rounded-3 fw-semibold">
                            <i class="bi bi-building me-2 text-primary"></i>@Model.Auditoria.AreaAuditada
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="small text-muted d-block mb-1">Periodo</label>
                        <div class="p-3 bg-body-tertiary rounded-3">
                            <i class="bi bi-calendar-range me-2 text-primary"></i>
                            <span class="fw-semibold">@Model.Auditoria.FechaInicio.ToShortDateString() - @Model.Auditoria.FechaFin.ToShortDateString()</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="small text-muted d-block mb-1">Responsable</label>
                        <div class="p-3 bg-body-tertiary rounded-3 fw-semibold">
                            <i class="bi bi-person me-2 text-primary"></i>@Model.ResponsableNombre
                            <div class="small text-muted fw-normal mt-1 font-monospace" style="font-size: 0.75rem;">ID: @Model.Auditoria.ResponsableId</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Acciones Rápidas -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 bg-primary text-white h-100">
            <div class="card-body p-4 d-flex flex-column">
                <h5 class="fw-bold mb-4">Acciones</h5>
                
                @if (Model.Auditoria.Estado == AuditManager.Core.Enums.EstadoAuditoria.EnProceso)
                {
                    <a asp-page="/Hallazgos/Create" asp-route-auditoriaId="@Model.Auditoria.Id" class="btn btn-light rounded-pill mb-3 py-2 fw-semibold w-100">
                        <i class="bi bi-bug me-2"></i>Registrar Hallazgo
                    </a>
                    <form method="post" asp-page-handler="Finalize" asp-route-id="@Model.Auditoria.Id" class="mb-3">
                        <button type="submit" class="btn btn-success rounded-pill py-2 fw-semibold w-100 shadow-sm" onclick="return confirm('¿Está seguro de finalizar esta auditoría?');">
                            <i class="bi bi-check-all me-2"></i>Finalizar Auditoría
                        </button>
                    </form>
                }
                
                <a asp-page="/Index" class="btn btn-outline-light rounded-pill py-2 fw-semibold w-100 mt-auto">
                    <i class="bi bi-arrow-left me-2"></i>Volver al Listado
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Hallazgos Section -->
<div class="row mb-3 align-items-center">
    <div class="col">
        <h4 class="fw-bold mb-0">Hallazgos Registrados</h4>
    </div>
    <div class="col-auto">
        <form method="get" asp-page="/Auditorias/Details" asp-route-id="@Model.Auditoria.Id" class="d-flex gap-2">
            <select name="SeveridadFiltro" asp-items="Model.SeveridadesSelectList" class="form-select form-select-sm border-secondary-subtle bg-body-tertiary rounded-3 shadow-none">
                <option value="">Severidad: Todas</option>
            </select>
            <button type="submit" class="btn btn-sm btn-secondary rounded-3 px-3">Filtrar</button>
            <a asp-page="/Auditorias/Details" asp-route-id="@Model.Auditoria.Id" class="btn btn-sm btn-outline-secondary rounded-3">
                <i class="bi bi-x-lg"></i>
            </a>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-body-tertiary border-bottom font-monospace">
                <tr>
                    <th class="ps-4">Descripción</th>
                    <th>Tipo</th>
                    <th>Severidad</th>
                    <th>Detectado</th>
                    @if (Model.Auditoria.Estado == AuditManager.Core.Enums.EstadoAuditoria.EnProceso)
                    {
                        <th class="pe-4 text-end"></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model.Hallazgos)
                {
                    <tr>
                        <td class="ps-4">@h.Descripcion</td>
                        <td><span class="text-muted small">@(h.Tipo == AuditManager.Core.Enums.TipoHallazgo.NoConformidad ? "No Conformidad" : h.Tipo.ToString())</span></td>
                        <td>
                            @{
                                var sevClass = h.Severidad == AuditManager.Core.Enums.SeveridadHallazgo.Alta ? "danger" : 
                                             h.Severidad == AuditManager.Core.Enums.SeveridadHallazgo.Media ? "warning" : "success";
                                var sevIcon = h.Severidad == AuditManager.Core.Enums.SeveridadHallazgo.Alta ? "bi-fire" : 
                                            h.Severidad == AuditManager.Core.Enums.SeveridadHallazgo.Media ? "bi-exclamation-triangle" : "bi-info-circle";
                            }
                            <span class="badge bg-@sevClass bg-opacity-10 text-@sevClass border border-@sevClass fw-normal">
                                <i class="bi @sevIcon me-1"></i>@h.Severidad
                            </span>
                        </td>
                        <td class="small text-muted">@h.FechaDeteccion.ToShortDateString()</td>
                        @if (Model.Auditoria.Estado == AuditManager.Core.Enums.EstadoAuditoria.EnProceso)
                        {
                            <td class="pe-4 text-end">
                                <form method="post" asp-page-handler="DeleteHallazgo" asp-route-hallazgoId="@h.Id" asp-route-auditoriaId="@Model.Auditoria.Id">
                                    <button type="submit" class="btn btn-sm btn-link text-danger border border-secondary-subtle bg-body shadow-sm rounded-pill py-1" onclick="return confirm('¿Eliminar este hallazgo?');">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        }
                    </tr>
                }
                @if (!Model.Hallazgos.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-journal-check fs-1 d-block mb-3 opacity-25"></i>
                            No hay hallazgos registrados para esta auditoría.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
