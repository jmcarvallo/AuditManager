@page
@model AuditManager.Web.Pages.Hallazgos.CreateModel
@{
    ViewData["Title"] = "Agregar Hallazgo";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4 text-center">
                <div class="bg-primary bg-opacity-10 text-primary d-inline-block p-3 rounded-pill mb-3">
                    <i class="bi bi-bug fs-3"></i>
                </div>
                <h4 class="fw-bold mb-0">Registrar Hallazgo</h4>
                <p class="text-muted small">Documente las discrepancias encontradas durante la auditoría</p>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Command.AuditoriaId" />

                    <div class="form-floating mb-3">
                        <textarea asp-for="Command.Descripcion" class="form-control border-light bg-light rounded-3" placeholder="Descripción" style="height: 120px"></textarea>
                        <label asp-for="Command.Descripcion">Descripción del Hallazgo</label>
                        <span asp-validation-for="Command.Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Command.Tipo" class="form-label small fw-bold text-muted uppercase ms-2">Tipo</label>
                                <select asp-for="Command.Tipo" class="form-select border-light bg-light rounded-3 shadow-none" asp-items="Html.GetEnumSelectList<AuditManager.Core.Enums.TipoHallazgo>()">
                                </select>
                                <span asp-validation-for="Command.Tipo" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Command.Severidad" class="form-label small fw-bold text-muted uppercase ms-2">Severidad</label>
                                <select asp-for="Command.Severidad" class="form-select border-light bg-light rounded-3 shadow-none" asp-items="Html.GetEnumSelectList<AuditManager.Core.Enums.SeveridadHallazgo>()">
                                </select>
                                <span asp-validation-for="Command.Severidad" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Command.FechaDeteccion" type="datetime-local" class="form-control border-light bg-light rounded-3" placeholder="Fecha" />
                        <label asp-for="Command.FechaDeteccion">Fecha y Hora de Detección</label>
                        <span asp-validation-for="Command.FechaDeteccion" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm py-2 fw-semibold">
                            <i class="bi bi-check-circle me-2"></i>Guardar Hallazgo
                        </button>
                        <a asp-page="/Auditorias/Details" asp-route-id="@Model.Command.AuditoriaId" class="btn btn-light border rounded-pill px-4 py-2">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
