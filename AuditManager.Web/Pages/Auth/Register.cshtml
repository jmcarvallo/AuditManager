@page
@model AuditManager.Web.Pages.Auth.RegisterModel
@{
    ViewData["Title"] = "Registrarse";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AuditManager — Registro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { background-color: #f8f9fa; }
        .card { border-radius: 1rem; border: none; }
        .btn-success { border-radius: 0.5rem; padding: 0.75rem; font-weight: 600; }
        .form-floating > label { color: #6c757d; }
        .vh-100 { min-height: 100vh; }
    </style>
</head>
<body>
<div class="container py-5">
    <div class="row justify-content-center align-items-center vh-100">
        <div class="col-md-6 col-lg-5">
            <div class="text-center mb-4">
                <h1 class="fw-bold text-primary"><i class="bi bi-shield-check me-2"></i>AuditManager</h1>
                <p class="text-muted">Únete a la plataforma de auditoría más avanzada</p>
            </div>
            
            <div class="card shadow-lg">
                <div class="card-body p-5">
                    <h4 class="fw-bold mb-4">Crear Cuenta</h4>
                    
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div>@Model.ErrorMessage</div>
                        </div>
                    }

                    <form method="post">
                        <div class="row g-2">
                            <div class="col-md">
                                <div class="form-floating mb-3">
                                    <input asp-for="Username" class="form-control" placeholder="Usuario" required autofocus />
                                    <label asp-for="Username">Usuario</label>
                                    <span asp-validation-for="Username" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md">
                                <div class="form-floating mb-3">
                                    <input asp-for="Correo" type="email" class="form-control" placeholder="Correo" required />
                                    <label asp-for="Correo">Correo Electrónico</label>
                                    <span asp-validation-for="Correo" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-floating mb-3">
                            <input asp-for="Password" type="password" class="form-control" placeholder="Contraseña" required />
                            <label asp-for="Password">Contraseña</label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-floating mb-4">
                            <input asp-for="Cargo" class="form-control" placeholder="Cargo" required />
                            <label asp-for="Cargo">Cargo / Posición</label>
                            <span asp-validation-for="Cargo" class="text-danger small"></span>
                        </div>
                        
                        <div class="d-grid mb-4">
                            <button type="submit" class="btn btn-success shadow-sm">
                                <i class="bi bi-person-plus me-2"></i>Crear Cuenta
                            </button>
                        </div>
                        
                        <div class="text-center">
                            <p class="text-muted mb-0">¿Ya tienes cuenta? <a asp-page="/Auth/Login" class="text-decoration-none fw-bold">Inicia sesión</a></p>
                        </div>
                    </form>
                </div>
            </div>
            <p class="text-center text-muted mt-4 small">&copy; 2026 AuditManager Suite</p>
        </div>
    </div>
</div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
