@page
@model AuditManager.Web.Pages.Reportes.IndexModel
@{
    ViewData["Title"] = "Reporte de Auditorías Finalizadas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Reporte de Auditorías Finalizadas</h1>
</div>

<form method="get" class="card card-body bg-light mb-4">
    <div class="row align-items-end g-3">
        <div class="col-md-4">
            <label for="FechaInicio" class="form-label fw-semibold">Fecha Fin desde</label>
            <input type="date" id="FechaInicio" name="FechaInicio" class="form-control"
                   value="@(Model.FechaInicio.HasValue ? Model.FechaInicio.Value.ToString("yyyy-MM-dd") : "")" />
        </div>
        <div class="col-md-4">
            <label for="FechaFin" class="form-label fw-semibold">Fecha Fin hasta</label>
            <input type="date" id="FechaFin" name="FechaFin" class="form-control"
                   value="@(Model.FechaFin.HasValue ? Model.FechaFin.Value.ToString("yyyy-MM-dd") : "")" />
        </div>
        <div class="col-md-auto">
            <button type="submit" class="btn btn-secondary">Filtrar</button>
            <a asp-page="/Reportes/Index" class="btn btn-outline-secondary ms-1">Limpiar</a>
        </div>
    </div>
</form>

@if (!Model.Reporte.Any())
{
    <div class="alert alert-info">
        No hay auditorías finalizadas para mostrar en el período seleccionado.
    </div>
}
else
{
    <div class="mb-3 text-muted small">
        Mostrando <strong>@Model.Reporte.Count</strong> auditoría(s) finalizada(s)
        &mdash; Total hallazgos: <strong>@Model.Reporte.Sum(r => r.TotalHallazgos)</strong>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Título</th>
                    <th>Área</th>
                    <th>Responsable</th>
                    <th>Fecha Fin</th>
                    <th class="text-center text-success">Baja</th>
                    <th class="text-center text-warning">Media</th>
                    <th class="text-center text-danger">Alta</th>
                    <th class="text-center">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Reporte)
                {
                    <tr>
                        <td>@item.Titulo</td>
                        <td>@item.AreaAuditada</td>
                        <td>@item.Responsable</td>
                        <td>@item.FechaFin.ToShortDateString()</td>
                        <td class="text-center">
                            <span class="badge bg-success">@item.HallazgosBaja</span>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-warning text-dark">@item.HallazgosMedia</span>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-danger">@item.HallazgosAlta</span>
                        </td>
                        <td class="text-center fw-bold">@item.TotalHallazgos</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-secondary fw-bold">
                <tr>
                    <td colspan="4" class="text-end">Totales:</td>
                    <td class="text-center">
                        <span class="badge bg-success">@Model.Reporte.Sum(r => r.HallazgosBaja)</span>
                    </td>
                    <td class="text-center">
                        <span class="badge bg-warning text-dark">@Model.Reporte.Sum(r => r.HallazgosMedia)</span>
                    </td>
                    <td class="text-center">
                        <span class="badge bg-danger">@Model.Reporte.Sum(r => r.HallazgosAlta)</span>
                    </td>
                    <td class="text-center">@Model.Reporte.Sum(r => r.TotalHallazgos)</td>
                </tr>
            </tfoot>
        </table>
    </div>
}
