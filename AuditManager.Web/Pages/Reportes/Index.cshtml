@page
@model AuditManager.Web.Pages.Reportes.IndexModel
@{
    ViewData["Title"] = "Reporte de Auditorías Finalizadas";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold mb-0">Reporte de Auditorías Finalizadas</h2>
        <p class="text-muted">Análisis detallado de hallazgos por severidad y cumplimiento</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <form method="get">
            <div class="row align-items-end g-3">
                <div class="col-md-4">
                    <label for="FechaInicio" class="form-label small fw-bold text-muted uppercase">Fecha Fin desde</label>
                    <input type="date" id="FechaInicio" name="FechaInicio" class="form-control border-secondary-subtle bg-body-tertiary rounded-3 shadow-none"
                           value="@(Model.FechaInicio.HasValue ? Model.FechaInicio.Value.ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-md-4">
                    <label for="FechaFin" class="form-label small fw-bold text-muted uppercase">Fecha Fin hasta</label>
                    <input type="date" id="FechaFin" name="FechaFin" class="form-control border-secondary-subtle bg-body-tertiary rounded-3 shadow-none"
                           value="@(Model.FechaFin.HasValue ? Model.FechaFin.Value.ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-md-auto d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
                        <i class="bi bi-filter me-1"></i>Filtrar
                    </button>
                    <a asp-page="/Reportes/Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Limpiar
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!Model.Reporte.Any())
{
    <div class="alert alert-info">
        No hay auditorías finalizadas para mostrar en el período seleccionado.
    </div>
}
else
{
    <div class="mb-3 text-muted small d-flex align-items-center gap-3">
        <span><i class="bi bi-file-earmark-text me-1"></i> Auditorías: <span class="fw-bold text-primary">@Model.Reporte.Count</span></span>
        <span class="vr"></span>
        <span><i class="bi bi-bug me-1"></i> Total Hallazgos: <span class="fw-bold text-danger">@Model.Reporte.Sum(r => r.TotalHallazgos)</span></span>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-body-tertiary border-bottom font-monospace">
                    <tr>
                        <th class="ps-4">Título</th>
                        <th>Área</th>
                        <th>Responsable</th>
                        <th>Fecha Fin</th>
                        <th class="text-center">Baja</th>
                        <th class="text-center">Media</th>
                        <th class="text-center">Alta</th>
                        <th class="pe-4 text-center">Total</th>
                    </tr>
                </thead>
            <tbody>
                @foreach (var item in Model.Reporte)
                {
                    <tr>
                        <td>@item.Titulo</td>
                        <td>@item.AreaAuditada</td>
                        <td>@item.Responsable</td>
                        <td>@item.FechaFin.ToShortDateString()</td>
                        <td class="text-center">
                            <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success fw-normal">@item.HallazgosBaja</span>
                        </td>
                        <td class="text-center">
                            <span class="badge rounded-pill bg-warning bg-opacity-10 text-warning border border-warning fw-normal">@item.HallazgosMedia</span>
                        </td>
                        <td class="text-center">
                            <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger fw-normal">@item.HallazgosAlta</span>
                        </td>
                        <td class="pe-4 text-center fw-bold">@item.TotalHallazgos</td>
                    </tr>
                }
            </tbody>
                <tfoot class="bg-body-tertiary fw-bold border-top">
                    <tr>
                        <td colspan="4" class="text-end pe-3 ps-4">Totales Consolidados:</td>
                        <td class="text-center">
                            <span class="badge rounded-pill bg-success bg-opacity-25 text-success border border-success">@Model.Reporte.Sum(r => r.HallazgosBaja)</span>
                        </td>
                        <td class="text-center">
                            <span class="badge rounded-pill bg-warning bg-opacity-25 text-warning border border-warning">@Model.Reporte.Sum(r => r.HallazgosMedia)</span>
                        </td>
                        <td class="text-center">
                            <span class="badge rounded-pill bg-danger bg-opacity-25 text-danger border border-danger">@Model.Reporte.Sum(r => r.HallazgosAlta)</span>
                        </td>
                        <td class="pe-4 text-center text-primary fs-5">@Model.Reporte.Sum(r => r.TotalHallazgos)</td>
                    </tr>
                </tfoot>
        </table>
    </div>
</div>
}
