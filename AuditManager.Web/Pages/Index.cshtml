@page
@model IndexModel
@{
    ViewData["Title"] = "Auditorías";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-0">Panel de Control de Auditorías</h2>
            <p class="text-muted">Gestión y seguimiento de procesos de auditoría enterprise</p>
        </div>
        <a asp-page="/Auditorias/Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-2"></i>Nueva Auditoría
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-2">
            <div class="card-body d-flex align-items-center">
                <div class="flex-shrink-0 bg-primary bg-opacity-10 text-primary p-3 rounded-3 me-3">
                    <i class="bi bi-layers-fill fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Total Auditorías</h6>
                    <h3 class="fw-bold mb-0">@Model.TotalAuditorias</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-2">
            <div class="card-body d-flex align-items-center">
                <div class="flex-shrink-0 bg-warning bg-opacity-10 text-warning p-3 rounded-3 me-3">
                    <i class="bi bi-clock-history fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Pendientes</h6>
                    <h3 class="fw-bold mb-0">@Model.Pendientes</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-2">
            <div class="card-body d-flex align-items-center">
                <div class="flex-shrink-0 bg-info bg-opacity-10 text-info p-3 rounded-3 me-3">
                    <i class="bi bi-gear-wide-connected fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">En Proceso</h6>
                    <h3 class="fw-bold mb-0">@Model.EnProceso</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-2">
            <div class="card-body d-flex align-items-center">
                <div class="flex-shrink-0 bg-success bg-opacity-10 text-success p-3 rounded-3 me-3">
                    <i class="bi bi-check2-all fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Finalizadas</h6>
                    <h3 class="fw-bold mb-0">@Model.Finalizadas</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filtros -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <form method="get">
            <div class="row align-items-end g-3">
                <div class="col-md-3">
                    <label asp-for="ResponsableId" class="form-label small fw-bold text-muted uppercase">Responsable</label>
                    <select asp-for="ResponsableId" asp-items="Model.ResponsablesSelectList" class="form-select border-secondary-subtle bg-body-tertiary rounded-3 shadow-none">
                        <option value="">-- Todos --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label asp-for="Estado" class="form-label small fw-bold text-muted">Estado</label>
                    <select asp-for="Estado" asp-items="Model.EstadosSelectList" class="form-select border-secondary-subtle bg-body-tertiary rounded-3 shadow-none">
                        <option value="">-- Todos --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label asp-for="FechaInicio" class="form-label small fw-bold text-muted">Inicio</label>
                    <input type="date" asp-for="FechaInicio" class="form-control border-secondary-subtle bg-body-tertiary rounded-3 shadow-none" />
                </div>
                <div class="col-md-2">
                    <label asp-for="FechaFin" class="form-label small fw-bold text-muted">Fin</label>
                    <input type="date" asp-for="FechaFin" class="form-control border-secondary-subtle bg-body-tertiary rounded-3 shadow-none" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary rounded-3 px-3 flex-grow-1">
                        <i class="bi bi-filter me-1"></i>Filtrar
                    </button>
                    <a asp-page="/Index" class="btn btn-outline-secondary rounded-3 px-3">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Tabla -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-body-tertiary border-bottom font-monospace">
                <tr>
                    <th class="ps-4 py-3">Título</th>
                    <th class="py-3">Área</th>
                    <th class="py-3">Periodo</th>
                    <th class="py-3">Estado</th>
                    <th class="pe-4 py-3 text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Auditorias)
                {
                    <tr>
                        <td class="ps-4 py-3 fw-semibold">@item.Titulo</td>
                        <td class="py-3">@item.AreaAuditada</td>
                        <td class="py-3 small text-muted">
                            <i class="bi bi-calendar3 me-1"></i>
                            @item.FechaInicio.ToShortDateString() - @item.FechaFin.ToShortDateString()
                        </td>
                        <td class="py-3">
                            @{
                                var badgeClass = item.Estado == AuditManager.Core.Enums.EstadoAuditoria.Pendiente ? "bg-warning" : 
                                               item.Estado == AuditManager.Core.Enums.EstadoAuditoria.EnProceso ? "bg-info" : "bg-success";
                                var icon = item.Estado == AuditManager.Core.Enums.EstadoAuditoria.Pendiente ? "bi-clock" : 
                                          item.Estado == AuditManager.Core.Enums.EstadoAuditoria.EnProceso ? "bi-play-circle" : "bi-check-circle";
                            }
                            <span class="badge rounded-pill @badgeClass bg-opacity-10 text-@badgeClass.Replace("bg-", "") border border-@badgeClass.Replace("bg-", "") shadow-sm">
                                <i class="bi @icon me-1"></i>@item.Estado
                            </span>
                        </td>
                        <td class="pe-4 py-3 text-end">
                            <div class="btn-group shadow-sm rounded-pill overflow-hidden border border-secondary-subtle bg-body">
                                <a asp-page="/Auditorias/Details" asp-route-id="@item.Id" class="btn btn-sm btn-link text-primary border-0" title="Detalles">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (item.Estado == AuditManager.Core.Enums.EstadoAuditoria.Pendiente)
                                {
                                    <a asp-page="/Auditorias/Edit" asp-route-id="@item.Id" class="btn btn-sm btn-link text-warning border-0 border-start border-secondary-subtle" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Auditorias.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-3 opacity-25"></i>
                            No hay auditorías que coincidan con los filtros.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
