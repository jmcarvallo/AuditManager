@page
@model IndexModel
@{
    ViewData["Title"] = "Auditorías";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Listado de Auditorías</h1>
    <a asp-page="/Auditorias/Create" class="btn btn-primary">Nueva Auditoría</a>
</div>

<form method="get" class="card card-body bg-light mb-4">
    <div class="row align-items-end g-3">
        <div class="col-md-3">
            <label for="ResponsableId" class="form-label fw-semibold">Responsable</label>
            <select id="ResponsableId" name="ResponsableId" asp-items="Model.ResponsablesSelectList" class="form-select">
                <option value="">-- Todos --</option>
            </select>
        </div>
        <div class="col-md-2">
            <label for="Estado" class="form-label fw-semibold">Estado</label>
            <select id="Estado" name="Estado" asp-items="Model.EstadosSelectList" class="form-select">
                <option value="">-- Todos --</option>
            </select>
        </div>
        <div class="col-md-2">
            <label for="FechaInicio" class="form-label fw-semibold">Inicio desde</label>
            <input type="date" id="FechaInicio" name="FechaInicio" class="form-control"
                   value="@(Model.FechaInicio.HasValue ? Model.FechaInicio.Value.ToString("yyyy-MM-dd") : "")" />
        </div>
        <div class="col-md-2">
            <label for="FechaFin" class="form-label fw-semibold">Fin hasta</label>
            <input type="date" id="FechaFin" name="FechaFin" class="form-control"
                   value="@(Model.FechaFin.HasValue ? Model.FechaFin.Value.ToString("yyyy-MM-dd") : "")" />
        </div>
        <div class="col-md-auto">
            <button type="submit" class="btn btn-secondary">Filtrar</button>
            <a asp-page="/Index" class="btn btn-outline-secondary ms-1">Limpiar</a>
        </div>
    </div>
</form>

<table class="table table-striped table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>Título</th>
            <th>Área Auditada</th>
            <th>Fecha Inicio</th>
            <th>Fecha Fin</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Auditorias)
        {
            <tr>
                <td>@item.Titulo</td>
                <td>@item.AreaAuditada</td>
                <td>@item.FechaInicio.ToShortDateString()</td>
                <td>@item.FechaFin.ToShortDateString()</td>
                <td>
                    <span class="badge @(item.Estado == AuditManager.Core.Enums.EstadoAuditoria.Pendiente ? "bg-warning" : item.Estado == AuditManager.Core.Enums.EstadoAuditoria.EnProceso ? "bg-info" : "bg-success")">
                        @item.Estado
                    </span>
                </td>
                <td>
                    <a asp-page="/Auditorias/Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>
                    @if (item.Estado == AuditManager.Core.Enums.EstadoAuditoria.Pendiente)
                    {
                        <a asp-page="/Auditorias/Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    }
                </td>
            </tr>
        }
        @if (!Model.Auditorias.Any())
        {
            <tr>
                <td colspan="6" class="text-center">No hay auditorías registradas.</td>
            </tr>
        }
    </tbody>
</table>
