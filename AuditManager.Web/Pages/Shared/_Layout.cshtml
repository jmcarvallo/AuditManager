<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AuditManager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AuditManager.Web.styles.css" asp-append-version="true" />
    <style>
        :root {
            --bs-body-bg: #f8f9fa;
        }
        .navbar {
            transition: all 0.3s ease;
        }
        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        .card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
    </style>
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-white bg-white border-0 shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand text-primary" asp-area="" asp-page="/Index">
                    <i class="bi bi-shield-check me-2"></i>AuditManager
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark px-3 mt-1" asp-area="" asp-page="/Index">
                                <i class="bi bi-list-task me-1"></i>Auditorías
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark px-3 mt-1" asp-area="" asp-page="/Responsables/Index">
                                <i class="bi bi-people me-1"></i>Responsables
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark px-3 mt-1" asp-area="" asp-page="/Reportes/Index">
                                <i class="bi bi-graph-up me-1"></i>Reportes
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-3">
                                <span class="badge bg-light text-dark border p-2 rounded-pill">
                                    <i class="bi bi-person-circle me-1 text-primary"></i>
                                    @User.Identity.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Auth/Logout" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                        <i class="bi bi-box-arrow-right me-1"></i>Salir
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer py-4 bg-white border-top text-muted mt-auto">
        <div class="container text-center">
            &copy; 2026 - <span class="fw-bold">AuditManager</span> - Enterprise Suite
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>