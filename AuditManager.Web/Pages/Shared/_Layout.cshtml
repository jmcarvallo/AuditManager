<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AuditManager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AuditManager.Web.styles.css" asp-append-version="true" />
    <script>
        // Pre-render theme check to avoid flicker
        (function() {
            const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
    <style>
        [data-bs-theme="light"] {
            --bs-body-bg: #f8f9fa;
        }
        [data-bs-theme="dark"] .badge.bg-opacity-10 {
            background-opacity: 0.25 !important;
            --bs-bg-opacity: 0.25;
        }
        .navbar {
            transition: background-color 0.3s ease, border-color 0.3s ease;
        }
        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        .card {
            transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.3s ease;
        }
        /* Fix for better visibility in dark mode badges */
        [data-bs-theme="dark"] .badge {
            border-width: 1.5px !important;
        }
        .theme-toggle-btn {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm border-bottom shadow-sm mb-4 py-3">
            <div class="container">
                <a class="navbar-brand text-primary d-flex align-items-center" asp-area="" asp-page="/Index">
                    <div class="bg-primary text-white p-2 rounded-3 me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="bi bi-shield-check fs-5"></i>
                    </div>
                    <span>AuditManager</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <i class="bi bi-list"></i>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-page="/Index">
                                <i class="bi bi-list-task me-1"></i>Auditorías
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-page="/Responsables/Index">
                                <i class="bi bi-people me-1"></i>Responsables
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-page="/Reportes/Index">
                                <i class="bi bi-graph-up me-1"></i>Reportes
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item me-2">
                             <button class="btn btn-link nav-link theme-toggle-btn rounded-circle border-0 text-secondary" id="themeToggle" title="Cambiar tema">
                                <i class="bi bi-sun-fill" id="themeIcon"></i>
                             </button>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-3">
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 p-2 px-3 rounded-pill fw-medium">
                                    <i class="bi bi-person-circle me-1"></i>
                                    @User.Identity.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Auth/Logout" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold">
                                        <i class="bi bi-box-arrow-right me-1"></i>Salir
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer py-4 border-top text-muted mt-auto bg-body-tertiary">
        <div class="container text-center">
            &copy; 2026 - <span class="fw-bold text-primary">AuditManager</span> - Enterprise Suite
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const html = document.documentElement;
            const themeToggle = document.getElementById('themeToggle');
            const themeIcon = document.getElementById('themeIcon');

            const getStoredTheme = () => localStorage.getItem('theme');
            const setStoredTheme = theme => localStorage.setItem('theme', theme);
            const getPreferredTheme = () => {
                const storedTheme = getStoredTheme();
                if (storedTheme) return storedTheme;
                return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            };

            const updateUI = (theme) => {
                if (theme === 'dark') {
                    themeIcon.classList.replace('bi-sun-fill', 'bi-moon-stars-fill');
                    themeToggle.classList.add('text-warning');
                } else {
                    themeIcon.classList.replace('bi-moon-stars-fill', 'bi-sun-fill');
                    themeToggle.classList.remove('text-warning');
                }
            };

            // Initialize UI
            const currentTheme = html.getAttribute('data-bs-theme');
            updateUI(currentTheme);

            themeToggle.addEventListener('click', () => {
                const newTheme = html.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
                html.setAttribute('data-bs-theme', newTheme);
                setStoredTheme(newTheme);
                updateUI(newTheme);
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>